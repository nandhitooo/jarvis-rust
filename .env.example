# Nama variabel environment (isi nilainya di .env, jangan commit nilainya).

# Token bot Discord (wajib)
DISCORD_TOKEN=

# Backend AI — pakai salah satu: custom Jarvis API atau Groq langsung
JARVIS_API_URL=
JARVIS_API_SECRET=
GROQ_API_KEY=

# Daftar model Groq (opsional; ada nilai default di kode)
GROQ_MODEL_1=
GROQ_MODEL_LABEL_1=
GROQ_MODEL_2=
GROQ_MODEL_LABEL_2=
GROQ_MODEL_3=
GROQ_MODEL_LABEL_3=

# Custom Image API (opsional, untuk perintah image)
CUSTOM_IMAGE_API_URL=
CUSTOM_IMAGE_API_KEY=
